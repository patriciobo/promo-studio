# Copiá a .env y completá. Las claves de Meta, OpenRouter, GitHub y WAHA también se pueden cargar desde la web
# (Configuración → Claves), donde quedan cifradas con APP_SECRET.

# Base de datos (en docker compose se arma sola)
DATABASE_URL=postgresql://promo:promo@localhost:5434/promo
POSTGRES_PASSWORD=promo

# URL pública HTTPS del servicio: Instagram descarga la media desde acá (p. ej. https://promo.tudominio.com)
PUBLIC_URL=http://localhost:3000
# Clave para cifrar los secretos guardados desde la web (32+ caracteres al azar: openssl rand -hex 32)
APP_SECRET=

# Login con GitHub (OAuth App: callback https://promo.tudominio.com/api/auth/callback/github)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGIN=patriciobo
# Sólo en desarrollo: entrar sin GitHub
AUTH_BYPASS=0

# Tope global mensual de OpenRouter (USD, todas las apps)
GLOBAL_BUDGET_USD=15
# Modo demo: arma la semana sin llamar a modelos (no gasta crédito)
OPENROUTER_MOCK=0

# Opcionales (si no se cargan desde la web)
META_TOKEN=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
WAHA_URL=
WAHA_API_KEY=
WAHA_CHAT_ID=

# Zona horaria de los crons del worker (lote del domingo 18:00)
WORKER_TZ=America/Argentina/Buenos_Aires
