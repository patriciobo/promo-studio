// Promo Studio: apps conectadas, lotes semanales, posts, archivos generados, métricas, anuncios y costos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  repo             String // owner/name en GitHub
  branch           String    @default("main")
  manifestPath     String    @default("promo.yaml")
  manifest         Json? // último promo.yaml válido (ya parseado)
  manifestHash     String?
  manifestError    String?
  syncedAt         DateTime?
  // Meta / Instagram
  pageId           String?
  igUserId         String?
  igUsername       String?
  adAccountId      String?
  // Generación
  textModel        String    @default("google/gemini-3.5-flash")
  imageModel       String?
  imageQuality     String? // low | medium | high, para modelos que cobran según la calidad
  imageKind        String? // illustration | photo (null = illustration)
  designStyle      String? // estilo de las piezas (src/lib/styles.ts; null = clasico). brand.style del promo.yaml lo pisa al cambiar el yaml
  profileKit       Json? // último kit de perfil generado (textos y rutas de las imágenes)
  profileKitDone   Json? // qué partes del kit ya se aplicaron en Instagram
  styleSuggestions Json? // [{ id, reason }]: estilos que el modelo de texto sugiere para el negocio
  monthlyBudgetUsd Float     @default(7)
  adMonthlyBudget  Float? // tope mensual de anuncios en la moneda de la cuenta publicitaria (null = sin tope)
  // Publicación
  timezone         String    @default("America/Argentina/Buenos_Aires")
  postTime         String    @default("10:00")
  autoApproveHours Int       @default(48)
  dryRun           Boolean   @default(true)
  paused           Boolean   @default(false)
  whatsapp         String? // número del cliente (sólo dígitos, con código de país): recibe lo pendiente y aprueba respondiendo
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  batches  Batch[]
  posts    Post[]
  usage    UsageLedger[]
  campaigns AdCampaign[]
  linkHits LinkHit[]
  images   AppImage[]
  brand    BrandProject?
}

model Batch {
  id        String      @id @default(cuid())
  appId     String
  app       App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  weekStart DateTime // lunes de la semana que cubre
  status    BatchStatus @default(PLANNING)
  error     String?
  notes     String?
  brief     String? // consigna del usuario para la semana ("Generar semana")
  kind      String      @default("WEEK") // WEEK = lote semanal | STARTER = kit de publicaciones iniciales (weekStart = su primer día)
  imageIds  String[]    @default([]) // imágenes subidas en las que se basa la semana
  createdAt DateTime    @default(now())
  posts     Post[]

  @@unique([appId, weekStart, kind])
}

enum BatchStatus {
  PLANNING
  GENERATING
  READY
  FAILED
}

model Post {
  id          String     @id @default(cuid())
  appId       String
  app         App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type        PostType
  status      PostStatus @default(DRAFT)
  pillar      String?
  hook        String?
  caption     String     @default("")
  altText     String?
  slides      Json? // [{ title, body }]
  imagePrompt String?
  scheduledAt DateTime?
  reviewDueAt DateTime?
  publishedAt DateTime?
  igMediaId   String?
  permalink   String?
  attempts    Int        @default(0)
  error       String?
  score       Float?
  dailyDate   String? // AAAA-MM-DD si es de la edición diaria
  textCostUsd Float? // su parte del costo del modelo de texto (las imágenes suman Asset.costUsd)
  adOnly      Boolean    @default(false) // pieza sólo para anuncios: nunca se publica en el feed
  waNumber    Int? // número con el que se le mandó al cliente por WhatsApp para aprobar (null = sin mandar)
  waSentAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assets   Asset[]
  insights InsightSnapshot[]
  ads      Ad[]

  @@unique([appId, dailyDate, type])
  @@index([status, scheduledAt])
}

enum PostType {
  IMAGE
  CAROUSEL
  REEL
  STORY
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}

model Asset {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      AssetKind
  position  Int       @default(0)
  path      String // relativo a MEDIA_DIR
  width     Int?
  height    Int?
  prompt    String?
  model     String?
  costUsd   Float?
  createdAt DateTime  @default(now())
}

enum AssetKind {
  BACKGROUND // imagen generada por IA, sin texto
  SLIDE // pieza final (JPEG) que se publica
  VIDEO // reel o story en video
}

/// Imagen subida por el usuario (captura de la app o foto) para basar publicaciones en ella.
model AppImage {
  id          String       @id @default(cuid())
  appId       String
  app         App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  path        String // relativo a MEDIA_DIR
  kind        AppImageKind @default(SCREENSHOT)
  description String? // qué muestra, escrito por el modelo de texto al subirla
  note        String? // lo que el usuario quiere contar con ella
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  // Capturas de un flujo del promo.yaml (importadas de .promo/screens del repo)
  flowId      String?
  step        Int? // desde 0
  sha         String? // sha del archivo en el repo: sólo se vuelve a bajar si cambió

  @@unique([appId, flowId, step])
  @@index([appId, archived])
}

enum AppImageKind {
  SCREENSHOT // pantalla de la app: va enmarcada junto al texto
  PHOTO // foto o imagen: puede ir de fondo
}

model InsightSnapshot {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hoursAfter    Int
  reach         Int?
  views         Int?
  likes         Int?
  comments      Int?
  saves         Int?
  shares        Int?
  profileVisits Int?
  raw           Json?
  createdAt     DateTime @default(now())

  @@unique([postId, hoursAfter])
}

/** Campaña de Meta: 1 campaña → 1 conjunto (presupuesto, fechas, público) → 1 anuncio por publicación. */
model AdCampaign {
  id              String    @id @default(cuid())
  appId           String
  app             App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  name            String
  objective       String // TRAFFIC | AWARENESS | ENGAGEMENT | WHATSAPP
  budgetType      String    @default("LIFETIME") // LIFETIME (total, como Business Suite) | DAILY
  budget          Int // centavos de la moneda de la cuenta publicitaria
  currency        String?
  spendCap        Int? // tope duro de la campaña, en centavos
  startAt         DateTime
  endAt           DateTime
  targeting       Json // { countries, ageMin, ageMax, interests: [{ id, name }], advantage }
  placements      String    @default("instagram") // instagram | instagram_facebook
  cta             String    @default("LEARN_MORE")
  link            String?
  status          String    @default("DRAFT") // DRAFT (sin crear en Meta) | PAUSED | ACTIVE | COMPLETED
  effectiveStatus String?
  campaignId      String?
  adSetId         String?
  simulated       Boolean   @default(false) // creada con la app en simulación: no llamó a Meta
  error           String?
  metrics         Json?
  syncedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ads             Ad[]

  @@index([status])
}

model Ad {
  id              String     @id @default(cuid())
  campaignId      String
  campaign        AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  postId          String
  post            Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  creativeId      String?
  adId            String?
  effectiveStatus String?
  issues          String? // motivo de rechazo o problema de entrega informado por Meta
  error           String?
  metrics         Json?
  createdAt       DateTime   @default(now())

  @@unique([campaignId, postId])
}

model UsageLedger {
  id        String   @id @default(cuid())
  appId     String?
  app       App?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  kind      String // text | image
  model     String
  costUsd   Float
  tokens    Int?
  purpose   String?
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
}

model LinkHit {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  target    String
  createdAt DateTime @default(now())
}

/// Secretos cargados desde la web (cifrados con APP_SECRET). Si no están, se usan las variables de entorno.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Identidad de marca de una app (pestaña Marca): el brief, lo leído del repo y las rondas de 3 alternativas.
model BrandProject {
  id            String        @id @default(cuid())
  appId         String        @unique
  app           App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  brief         Json // src/lib/brand/brief.ts (BriefSchema)
  found         Json? // lo encontrado en el repo de la app: colores, tipografías, logo, frase
  elements      String[]      @default([]) // qué generar: logo, paleta, tipografia, voz, tagline, patron, nombre
  textModel     String        @default("google/gemini-3.5-flash")
  referencePath String? // logo de referencia subido (relativo a MEDIA_DIR)
  status        String        @default("idle") // idle | running | error
  error         String?
  progress      Json? // { started, done, total } o { started, vector }
  chosenId      String? // alternativa elegida
  // Último guardado en el repo
  savedOptionId String?
  savedAt       DateTime?
  savedUrl      String? // PR o commit; vacío si se escribió en un repo local
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  options       BrandOption[]
}

/// Una de las 3 alternativas de una ronda: concepto, paleta, tipografías, voz, logo y lámina de presentación.
model BrandOption {
  id         String       @id @default(cuid())
  projectId  String
  project    BrandProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  round      Int // 1, 2, 3… cada "Generar" suma una ronda
  index      Int // 0 a 2
  conceptId  String // src/lib/brand/concepts.ts
  data       Json // src/lib/brand/generate.ts (OptionSchema)
  logoPath   String?
  logoModel  String?
  vectorPath String? // SVG vectorizado del logo, si se pidió
  iconPath   String? // ícono cuadrado (sólo el símbolo o monograma) para favicons
  iconVector String? // SVG del ícono (favicon.svg), al vectorizar
  iconFiles  Json? // { "32": ruta, "180": ruta, "ico": ruta… }: PNG e .ico listos para el sitio
  boardPath  String? // lámina con todo, para mostrar y compartir
  costUsd    Float        @default(0)
  createdAt  DateTime     @default(now())

  @@unique([projectId, round, index])
}
